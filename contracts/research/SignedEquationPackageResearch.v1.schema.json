{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.boswelldigitalsolutions.com/forgemath/research/SignedEquationPackageResearch.v1.schema.json",
  "title": "SignedEquationPackageResearch.v1",
  "description": "Research envelope for an equation-package manifest and signature claims; no runtime verification or activation is implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_status",
    "manifest",
    "manifest_digest",
    "payload_type",
    "signatures",
    "verification_policy",
    "signature_status",
    "executable"
  ],
  "properties": {
    "schema_version": { "const": "SignedEquationPackageResearch.v1" },
    "contract_status": { "const": "research_only_not_runtime_authority" },
    "manifest": {
      "$ref": "https://schemas.boswelldigitalsolutions.com/forgemath/research/EquationPackageManifest.v1.schema.json"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload_type": {
      "const": "application/vnd.bds.forgemath.equation-package-manifest.v1+json"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "signature"],
        "properties": {
          "key_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "algorithm": { "enum": ["ed25519", "ecdsa-p256-sha256", "rsa-pss-sha256"] },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "minLength": 8
          }
        }
      }
    },
    "verification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "trusted_key_ids", "require_all_artifact_digests"],
      "properties": {
        "threshold": { "type": "integer", "minimum": 1 },
        "trusted_key_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "require_all_artifact_digests": { "const": true }
      }
    },
    "signature_status": { "const": "unverified_research_fixture" },
    "executable": { "const": false }
  }
}
