{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.boswelldigitalsolutions.com/forgemath/research/MathDecisionReceipt.v1.schema.json",
  "title": "MathDecisionReceipt.v1",
  "description": "Non-runtime research contract for a content-addressed ForgeMath decision receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_status",
    "receipt_id",
    "decision_id",
    "issued_at",
    "authority",
    "lane_evaluation",
    "equation_package_ref",
    "inputs",
    "outputs",
    "trace",
    "redaction",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "MathDecisionReceipt.v1" },
    "contract_status": { "const": "research_only_not_runtime_authority" },
    "receipt_id": { "type": "string", "pattern": "^math-receipt:[A-Za-z0-9._:-]+$" },
    "decision_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "issued_at": { "type": "string", "format": "date-time" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "execution_mode", "human_authority_posture"],
      "properties": {
        "service": { "const": "ForgeMath" },
        "execution_mode": { "const": "governed_canonical_execution" },
        "human_authority_posture": {
          "enum": ["approved_bundle_execution", "operator_review_required", "audit_only"]
        }
      }
    },
    "lane_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_evaluation_id",
        "lane_id",
        "lane_spec_version",
        "runtime_profile_id",
        "runtime_profile_version",
        "compatibility_tuple_hash",
        "raw_output_hash"
      ],
      "properties": {
        "lane_evaluation_id": { "type": "string", "minLength": 1, "maxLength": 36 },
        "lane_id": {
          "enum": [
            "verification_burden",
            "recurrence_pressure",
            "exposure_factor",
            "priority_score",
            "reviewability"
          ]
        },
        "lane_spec_version": { "type": "integer", "minimum": 1 },
        "runtime_profile_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "runtime_profile_version": { "type": "integer", "minimum": 1 },
        "compatibility_tuple_hash": { "$ref": "#/$defs/sha256Hex" },
        "raw_output_hash": { "$ref": "#/$defs/sha256Hex" }
      }
    },
    "equation_package_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equation_package_id", "version", "manifest_digest"],
      "properties": {
        "equation_package_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "version": { "type": "integer", "minimum": 1 },
        "manifest_digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactRef" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/outputValue" }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_bundle_id", "trace_bundle_hash", "trace_tier", "reconstructable"],
      "properties": {
        "trace_bundle_id": { "type": "string", "minLength": 1, "maxLength": 36 },
        "trace_bundle_hash": { "$ref": "#/$defs/sha256Hex" },
        "trace_tier": { "enum": ["tier_1_full", "tier_2_standard", "tier_3_reconstruction"] },
        "reconstructable": { "type": "boolean" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "redacted_fields"],
      "properties": {
        "posture": { "enum": ["none", "metadata_only", "payload_redacted"] },
        "redacted_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "activity_id", "responsible_agents", "used_entities", "generated_entities"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "activity_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "responsible_agents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "used_entities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "generated_entities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      }
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonicalDecimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "digest", "media_type"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "digest": { "$ref": "#/$defs/sha256Digest" },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "outputValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_field_name", "output_posture"],
      "properties": {
        "output_field_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "output_posture": { "enum": ["raw", "banded", "classified", "gated"] },
        "numeric_value": { "$ref": "#/$defs/canonicalDecimal" },
        "text_value": { "type": "string" },
        "enum_value": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "oneOf": [
        { "required": ["numeric_value"] },
        { "required": ["text_value"] },
        { "required": ["enum_value"] }
      ]
    }
  }
}
